<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <PackageId>Alma.Fable.Profiler</PackageId>
        <Version>9.0.1</Version>
        <Authors>Almacareer</Authors>
        <Description>Fable library with Profiler component.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/alma-oss/fable-profiler.git</RepositoryUrl>
        <PackageProjectUrl>https://github.com/alma-oss/fable-profiler</PackageProjectUrl>
        <NpmDependencies>
            <NpmPackage Name="tailwindcss" Version="gte 4.0.0 lt 5.0.0" ResolutionStrategy="Max" DevDependency="true" />
            <NpmPackage Name="daisyui" Version="gte 5.0.0 lt 6.0.0" ResolutionStrategy="Max" DevDependency="true" />
        </NpmDependencies>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="AssemblyInfo.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Model.fs" />
        <Compile Include="Profiler.fs" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="*.fsproj; *.fs; *.scss;" PackagePath="fable\" />
    </ItemGroup>

    <Import Project="..\..\.paket\Paket.Restore.targets" />

</Project>